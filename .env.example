# ============================================================
# Nesto Signup Automation — Environment Configuration
# Copy this file to .env and fill in actual values.
# ============================================================

# --- Target environment ---
# Supported values: qa | dev | staging
# The suite loads .env first, then overlays .env.<TEST_ENV>
# Example: TEST_ENV=dev loads .env.dev
TEST_ENV=qa

# --- Base URLs ---
BASE_URL=https://app.qa.nesto.ca

# --- Locale: 'en' or 'fr'
# Override at CLI with: LOCALE=fr npm test
# or set here to always run in a specific language
LOCALE=en

# --- Email (required) ---
# Email is always made unique per-test run (timestamp + random suffix appended).
TEST_EMAIL_PREFIX=nesto.qa.test
TEST_EMAIL_DOMAIN=mailinator.com

# --- Personal data (optional overrides) ---
# If left unset, faker generates a random value on every test run.
# Set these to pin known values in CI or when debugging a specific scenario.
# TEST_FIRST_NAME=Jean
# TEST_LAST_NAME=Dupont
# TEST_PHONE=5141234567
# TEST_PROVINCE=QC

TEST_COUNTRY_CODE=CA

# --- Password (optional override) ---
# If left unset, a valid random password is generated on every run.
# Must satisfy: 12-32 chars, 1 uppercase, 1 lowercase, 1 number
# TEST_PASSWORD=TestPass123!@#

# --- A registered email used for duplicate-account negative tests ---
# Run TC-P-01 once manually, then put the used email here.
TEST_EXISTING_EMAIL=nesto.qa.test+existing@mailinator.com

